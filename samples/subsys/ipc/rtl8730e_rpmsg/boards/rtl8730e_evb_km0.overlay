 * Copyright (c) 2026 Realtek Semiconductor Corp.
 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * KM0 (Real-M200 / Cortex-M23, "LP" core) = OpenAMP rpmsg REMOTE.
 *
 * IPC block: IPCLP @ 0x42008600 (this core's own doorbell view).
 * Interrupt : NVIC IRQ 0 (IPC_LP_IRQ), level triggered.
 *
 * mbox cells are ABSOLUTE register bits (see realtek,rtl8730e-ipc.yaml):
 *   tx = bit 4  (LP_TO_AP ch4, TX shift 0)
 *   rx = bit 20 (AP_TO_LP ch4, RX-full group shift 16 -> 16+4)
 *
 * Shared region: KM0 cannot reach PSRAM (its KM0_BD_DRAM is a len-0 sentinel),
 * so the CA32<->KM0 vring lives in KM0 SRAM at 0x2301B000 (16 KB) -- the only
 * window both CA32 and KM0 physically share.  KM0 (Cortex-M23) has no D-cache,
 * so no cache maintenance is needed on this side; the region is still marked
 * ATTR_MPU_RAM_NOCACHE for an explicit MPU mapping and symmetry with KM4.
 *
 * sram0 (KM0_BD_RAM) is shrunk to 0x23002020..0x2301B000 so the linker never
 * places .bss/heap over the shared window.
 */

#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

/ {
	sram_ipc_lp: memory@2301b000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2301b000 DT_SIZE_K(16)>;
		zephyr,memory-region = "SRAM_IPC_LP";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;
	};

	soc {
		ipc_mbox: mbox@42008600 {
			compatible = "realtek,rtl8730e-ipc";
			reg = <0x42008600 0x14>;
			interrupt-parent = <&nvic>;
			interrupts = <0 3>;
			#mbox-cells = <1>;
			status = "okay";
		};
	};

	ipc {
		#address-cells = <1>;
		#size-cells = <0>;

		ipc0: ipc0 {
			compatible = "zephyr,ipc-openamp-static-vrings";
			memory-region = <&sram_ipc_lp>;
			mboxes = <&ipc_mbox 4>, <&ipc_mbox 20>;
			mbox-names = "tx", "rx";
			role = "remote";
			status = "okay";
		};
	};
};

/* Reserve the top 16 KB of KM0_BD_RAM for the shared vring window. */
&sram0 {
	reg = <0x23002020 (0x2301b000 - 0x23002020)>;
};
