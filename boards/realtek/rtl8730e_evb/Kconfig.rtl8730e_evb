# The RTL8730E is a tri-core AmebaSmart SoC. Each core is exposed as a Zephyr
# CPU cluster (see soc/realtek/ameba/soc.yml), selected via the board target
# qualifier rtl8730e_evb/rtl8730e/<cluster>:
#
#   .../ca32 : dual Cortex-A32 application processor (SMP), boots via TF-A
#   .../km4  : Cortex-M55 network processor (KM4 app + MCUboot bootloader image)
#   .../km0  : Cortex-M23 low-power core
#
# Zephyr generates BOARD_<board>_<soc>_<cluster> for each qualifier; the board
# forwards the matching per-cluster hidden SoC symbol.
config BOARD_RTL8730E_EVB
	bool "RTL8730E EVB Platform Board"
	select SOC_RTL8730E_CA32 if BOARD_RTL8730E_EVB_RTL8730E_CA32
	select SOC_RTL8730E_KM4  if BOARD_RTL8730E_EVB_RTL8730E_KM4
	select SOC_RTL8730E_KM0  if BOARD_RTL8730E_EVB_RTL8730E_KM0
	# The CA32 application is loaded by ARM Trusted Firmware (BL2 → BL31/PSCI).
	select BUILD_WITH_TFA    if BOARD_RTL8730E_EVB_RTL8730E_CA32
