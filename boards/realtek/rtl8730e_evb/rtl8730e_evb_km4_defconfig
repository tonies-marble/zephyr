#
# Board defconfig for the KM4 (Cortex-M55) domain.
#
# These are the defaults for the KM4 *application* image.  The MCUboot
# bootloader image built on the same target overrides the app-specific bits
# (minimal libc, main-stack size, mbedTLS slots) from
# bootloader/mcuboot/boot/zephyr/boards/rtl8730e_evb_rtl8730e_km4.conf, so keep
# bootloader-only settings out of this file.

# Non-XIP, PSRAM-resident at KM4_BD_DRAM like the vendor KM4 firmware: the
# image2 packaging stubs the XIP slot, so an XIP image would not boot.
CONFIG_XIP=n

# UART console via the Ameba LogUART driver.
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
